{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/style.css",
      "dest": "web/style.css"
    },
    {
      "src": "/app.js",
      "dest": "web/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "web/index.html"
    }
  ]
}

